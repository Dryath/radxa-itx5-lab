+void ggml_ssm_scan_set_inplace(
+        struct ggml_tensor * scan,
+        int64_t              head) {
+    GGML_ASSERT(scan->op == GGML_OP_SSM_SCAN);
+    GGML_ASSERT(ggml_get_op_params_i32(scan, 0) == 1);
+    GGML_ASSERT(head >= 0 && head <= INT32_MAX);
+
+    ggml_set_op_params_i32(scan, 1, 1);
+    ggml_set_op_params_i32(scan, 2, (int32_t) head);
+}
