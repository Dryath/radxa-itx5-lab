diff --git a/src/llama-graph.cpp b/src/llama-graph.cpp
index 5855393..b212f3f 100644
--- a/src/llama-graph.cpp
+++ b/src/llama-graph.cpp
@@ -1511,6 +1511,29 @@ ggml_tensor * llm_graph_context::build_cvec(
     return cvec->apply_to(ctx0, cur, il);
 }
 
+ggml_tensor * llm_graph_context::build_lm_head(
+          ggml_tensor * w,
+          ggml_tensor * cur,
+          ggml_tensor * w_s,
+          ggml_tensor * w_trim,
+          ggml_tensor * trim_map) const {
+    if (w_trim == nullptr || w_s != nullptr) {
+        return build_lora_mm(w, cur, w_s);
+    }
+
+    // {n_embd, n_outputs} -> {n_keep, n_outputs}
+    ggml_tensor * logits = build_lora_mm(w_trim, cur);
+
+    // row n_keep holds -inf for every id that was not kept
+    ggml_tensor * ninf = ggml_fill(ctx0, ggml_cont(ctx0, ggml_view_2d(ctx0, logits, 1, logits->ne[1], logits->nb[1], 0)), -INFINITY);
+    logits = ggml_concat(ctx0, logits, ninf, 0);
+
+    // gather along the vocab dimension: {n_outputs, n_keep + 1} -> {n_outputs, n_vocab}
+    logits = ggml_get_rows(ctx0, ggml_cont(ctx0, ggml_transpose(ctx0, logits)), trim_map);
+
+    return ggml_cont(ctx0, ggml_transpose(ctx0, logits));
+}
+
 ggml_tensor * llm_graph_context::build_lora_mm(
           ggml_tensor * w,
           ggml_tensor * cur,
