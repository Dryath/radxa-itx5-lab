+// [LOCAL PATCH] models listed in the pin file are exempt from LRU eviction.
+// One model name per line, '#' comments allowed. Default path
+// ~/.config/llm-router/pinned, overridable via LLAMA_ROUTER_PIN_FILE. Re-read
+// on every victim pass, so changing the pinned main needs no restart.
+// If every candidate is pinned, pick_victim returns "" and no eviction occurs;
+// models_max is then exceeded — the cgroup memory guard is the real backstop.
+static std::set<std::string> router_pinned_models() {
+    std::set<std::string> pinned;
+    std::string path;
+    if (const char * p = getenv("LLAMA_ROUTER_PIN_FILE")) {
+        path = p;
+    } else if (const char * h = getenv("HOME")) {
+        path = std::string(h) + "/.config/llm-router/pinned";
+    } else {
+        return pinned;
+    }
+    std::ifstream f(path);
+    std::string line;
+    while (std::getline(f, line)) {
+        const size_t b = line.find_first_not_of(" \t");
+        if (b == std::string::npos) continue;
+        size_t e = line.find_last_not_of(" \t\r");
+        line = line.substr(b, e - b + 1);
+        if (!line.empty() && line[0] != '#') {
+            pinned.insert(line);
+        }
+    }
+    return pinned;
+}
