+@ModelBase.register("BailingMoeLinearV2ForCausalLM")
+@ModelBase.example("inclusionAI/Ring-mini-linear-2.0")
+class BailingMoeLinearV2Model(BailingMoeV2Model):
+    model_arch = gguf.MODEL_ARCH.BAILINGMOE_LINEAR
+
+    def is_linear_layer(self, bid: int) -> bool:
+        g = self.hparams["layer_group_size"]
+        n = self.hparams["num_hidden_layers"]
+        return not ((bid + 1) % g == 0 or bid >= n // g * g)
+
+    @staticmethod
+    def build_slope_tensor(n_heads: int) -> Tensor:
+        def get_slopes(n: int):
+            def pow2(n):
+                start = 2 ** (-(2 ** -(math.log2(n) - 3)))
+                return [start * start ** i for i in range(n)]
+            if math.log2(n).is_integer():
+                return pow2(n)
+            closest = 2 ** math.floor(math.log2(n))
+            return pow2(closest) + get_slopes(2 * closest)[0::2][: n - closest]
+        return torch.tensor(get_slopes(n_heads), dtype=torch.float32)
+
+    def set_gguf_parameters(self):
+        super().set_gguf_parameters()
+        hp = self.hparams
+        n_layer = hp["num_hidden_layers"]
+
+        # linear layers are marked by n_head_kv == 0 (kimi-linear convention)
+        self.gguf_writer.add_head_count_kv(
+            [0 if self.is_linear_layer(i) else hp["num_key_value_heads"] for i in range(n_layer)])
+        self.gguf_writer.add_group_norm_groups(hp["group_norm_size"])
+        self.gguf_writer.add_key_length(hp["head_dim"])
+        self.gguf_writer.add_value_length(hp["head_dim"])
+
+    def prepare_tensors(self):
+        super().prepare_tensors()
+        # the decay slope is a non-persistent buffer in the reference impl
+        n_head  = self.hparams["num_attention_heads"]
+        n_layer = self.hparams["num_hidden_layers"]
+        for bid in range(n_layer):
+            if not self.is_linear_layer(bid):
+                continue
+            slope = -self.build_slope_tensor(n_head) * (1 - (bid - 1) / (n_layer - 1) + 1e-5)
+            self.gguf_writer.add_tensor(
+                self.format_tensor_name(gguf.MODEL_TENSOR.SSM_A, bid), slope.numpy())
